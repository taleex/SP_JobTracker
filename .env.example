# ── Base de dados ──────────────────────────────────────────────
# URL de ligação à base de dados (Neon). Exemplo PostgreSQL:
# postgresql://user:password@host:port/database
DATABASE_URL=

# ── NextAuth ──────────────────────────────────────────────────
# Segredo usado para assinar/encriptar as sessões JWT.
# Gerar um com: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública da aplicação (usada pelo NextAuth).
# Em desenvolvimento: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
